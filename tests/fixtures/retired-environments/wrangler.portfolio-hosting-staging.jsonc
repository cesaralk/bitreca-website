{
  "name": "bitreca-portfolio-hosting-staging",
  "main": "portfolio-hosting/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "PORTFOLIO_DB", "database_name": "bitreca-portfolio-staging-db", "database_id": "c9f87f2a-12fd-45bf-bf94-02e0f1f24d07", "preview_database_id": "c9f87f2a-12fd-45bf-bf94-02e0f1f24d07", "migrations_dir": "./migrations", "remote": false }],
  "r2_buckets": [{ "binding": "PORTFOLIO_FILES", "bucket_name": "bitreca-portfolio-staging", "preview_bucket_name": "bitreca-portfolio-staging", "remote": false }],
  "vars": {
    "PORTFOLIO_ENVIRONMENT": "staging",
    "PORTFOLIO_STAGING_PREVIEW_ENABLED": "false",
    "PORTFOLIO_STAGING_HOSTNAME": "bitreca-portfolio-hosting-staging.ceasar-elkhatib.workers.dev",
    "PORTFOLIO_STAGING_PREVIEW_SLUG": "demo"
  },
  "triggers": { "crons": [] }
}

