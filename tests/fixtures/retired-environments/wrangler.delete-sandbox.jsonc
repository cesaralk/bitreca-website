    "compatibility_date":  "2026-09-23",
    "workers_dev":  false,
    "preview_urls":  false,
    "assets":  {
                   "directory":  "./dist/client",
                   "not_found_handling":  "single-page-application",
                   "run_worker_first":  [
                                            "/api/*"
                                        ]
               },
    "d1_databases":  [
                         {
                             "binding":  "bitreca_db",
