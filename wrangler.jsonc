{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bitreca-website",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-23",
	"observability": {
		"enabled": true
	},
"assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
        "/api/*"
    ]
},
	"d1_databases": [
		{
			"binding": "bitreca_db",
			"database_name": "bitreca-db",
			"database_id": "8ff2d1f7-e747-4fe8-a6a3-87898e1ae79a"
		}
	]
}