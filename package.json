{
  "name": "bitreca-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:portfolio": "node --test tests/admin-sessions.test.js tests/portfolio-*.test.js tests/portfolio-*.test.mjs",
    "check:portfolio-build": "node scripts/check-portfolio-build.mjs",
    "check:portfolio-ui": "node scripts/check-portfolio-ui.mjs",
    "check:portfolio-migrations": "node scripts/check-portfolio-migrations.mjs",
    "portfolio:evidence": "node scripts/portfolio-evidence.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wrangler": "^4.139.0"
  }
}
